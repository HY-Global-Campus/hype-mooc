# Optional overrides for docker compose (copy to repo root as .env if needed)
GCAI_URL=
GCAI_TOKEN=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Dev Container starts backend/frontend in the workspace via .devcontainer/post-start.sh
# (ports 5173, 8080, 5432). Rebuild the container after changing devcontainer config.
# Dev login is enabled by default (DEV_AUTH_BYPASS, VITE_DEV_AUTH_BYPASS). Set either to "false" to disable.
